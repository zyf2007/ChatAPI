# ChatAPI Go 后端环境变量示例
#
# 使用方法：复制为 backend/.env 后修改。程序还会依次读取 backend/.env.local、
# 项目根目录 .env，以及 CHATAPI_ENV_FILE 指定的文件；后读取的文件覆盖前面的值。
# 布尔值建议统一使用 1/0。时间使用 Go duration，例如 30s、5m、24h。
# 字节数使用整数：2 MiB=2097152，10 MiB=10485760，1 GiB=1073741824。
# 环境变量属于启动配置，修改后需要重启。管理员页面中被环境变量锁定的项目只读。

# ==============================================================================
# 监听地址与前端
# ==============================================================================

# 监听地址。直接对外服务推荐 0.0.0.0；仅本机反向代理可改为 127.0.0.1。
CHATAPI_HOST=0.0.0.0
# HTTP 端口，范围 1-65535。
CHATAPI_PORT=5000
# 对外公开基址，用于生成回调地址等；有域名时推荐填写 HTTPS，末尾不要加路径。
# 留空时由请求上下文推导。
CHATAPI_BASE_URL=
# 外置前端 dist 目录。使用 make build EMBED_FRONTEND=1 时嵌入资源优先，此项无需存在。
CHATAPI_WEB_DIST_DIR=../frontend/dist
# 允许携带 Cookie 的浏览器 Origin，逗号分隔，只写 scheme+host+port，不要带路径。
# 生产环境应加入实际前端域名；Vite 开发环境保留 localhost 项。
CHATAPI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 可信反向代理 IP 或 CIDR，逗号分隔。只有这些代理传来的转发头会被信任。
# 直连部署留空；Nginx 同机部署可填写 127.0.0.1,::1。
# Comma-separated reverse-proxy IPs/CIDRs allowed to supply client IP headers.
# Used by global rate limiting and App API Key source IP restrictions.
# Leave empty for direct connections; proxies must set/append X-Forwarded-For
# or overwrite X-Real-IP. Only list proxies you control, not client networks.
CHATAPI_TRUSTED_PROXIES=
# 可选外部环境文件路径。通常不要在 .env 自身设置，而是在进程环境中传入。
# CHATAPI_ENV_FILE=/etc/chatapi/chatapi.env

# ==============================================================================
# 数据目录与数据库
# ==============================================================================

# 应用数据根目录。相对路径以 backend 目录为基准。
CHATAPI_DATA_DIR=./data
# 可选 sqlite、postgres 或 postgresql。单实例推荐 sqlite。
CHATAPI_DB_DRIVER=sqlite
# SQLite 文件路径；切换 PostgreSQL 时改成 postgres://user:password@host:5432/chatapi?sslmode=require
CHATAPI_DB_DSN=./data/chatapi.sqlite3

# ==============================================================================
# 必要密钥与种子超级管理员
# ==============================================================================

# serve 模式必填，用于加密数据库中的模型 API Key。至少 32 个随机字符。
# 生成示例：openssl rand -base64 48
# 必须备份且不要随意更换，否则既有密文无法解密。
CHATAPI_MASTER_KEY=replace-with-a-long-random-master-key
# Session 签名密钥，推荐显式配置至少 32 个随机字符，多实例必须完全一致。
# 留空时程序会自动生成并持久化，但生产部署建议明确填写。
CHATAPI_SESSION_SECRET=replace-with-another-long-random-session-secret
# 两项同时填写才启用环境种子超级管理员；任一留空都会禁用该账号登录。
# 启动时会注册或刷新同一个全局唯一账号，修改用户名/密码不会丢失其数据。
CHATAPI_ADMIN_USERNAME=superadmin
CHATAPI_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# ==============================================================================
# 日志、指标与入口限流
# ==============================================================================

# debug、info、warn、error；生产推荐 info。
CHATAPI_LOG_LEVEL=info
# console 适合终端阅读，json 适合容器日志采集。
CHATAPI_LOG_FORMAT=console
# 输出额外彩色 HTTP 摘要行；开发推荐 1，生产结构化采集推荐 0。
CHATAPI_LOG_HTTP_SUMMARY_ENABLED=0
# 暴露 /metrics。公网部署需在反向代理或防火墙限制访问。
CHATAPI_METRICS_ENABLED=0
# 全局入口窗口内最大请求数，0 表示不限流。公网部署可从 600/1m 起步再观察。
CHATAPI_ACCESS_RATE_LIMIT_REQUESTS=0
CHATAPI_ACCESS_RATE_LIMIT_WINDOW=1m
# multipart 等普通上传请求的单文件上限，必须大于 0；推荐 10 MiB。
CHATAPI_UPLOAD_MAX_BYTES=10485760

# ==============================================================================
# 请求图片预处理
# ==============================================================================

# 开启图片识别、校验、AVIF 转码和本地资产引用。推荐保持开启。
CHATAPI_MEDIA_PROCESS_ENABLED=1
# 允许请求引用 http/https 图片 URL。当前远程 URL 会原样保留，不由后端下载转码。
# 对隐私或离线环境要求较高时建议关闭。
CHATAPI_MEDIA_ALLOW_REMOTE_URL=1
# 允许 data:image/...;base64,... 内嵌图片。成功后会转 AVIF，不保留原始 Data URL。
CHATAPI_MEDIA_ALLOW_DATA_URL=1
# 允许不带 data: 前缀的裸 Base64 图片；兼容性需要时开启，严格协议环境可关闭。
CHATAPI_MEDIA_ALLOW_BASE64=1
# SVG 可能包含主动内容，默认禁止，不建议在公网实例开启。
CHATAPI_MEDIA_ALLOW_SVG=0
# 单张解码后图片上限；推荐 2 MiB。0 表示不限制，但不建议使用 0。
CHATAPI_MEDIA_MAX_BYTES=2097152
# 单请求图片数量上限；推荐 8，0 表示不限制。
CHATAPI_MEDIA_MAX_IMAGES_PER_REQUEST=8
# AVIF 输出目录；通常保持在数据目录中。
CHATAPI_MEDIA_DERIVED_DIR=./data/derived/request_media
# AVIF 质量，范围由编码器约束；推荐 60，越高文件通常越大。
CHATAPI_MEDIA_AVIF_QUALITY=60
# Optional shared processor. Production remote-only builds require both values.
CHATAPI_IMAGE_PROCESSOR_URL=
CHATAPI_IMAGE_PROCESSOR_API_TOKEN=

# ==============================================================================
# 存储配额与定时清理
# ==============================================================================

# 每个用户默认存储配额，0 表示不限额。管理员可为单用户设置覆盖值。
CHATAPI_STORAGE_DEFAULT_QUOTA_BYTES=0
# 达到存储策略限制后阻止创建新会话。默认关闭。
CHATAPI_STORAGE_BLOCK_NEW_CONVERSATIONS=0
# 每日自动清理。启用前先确认保留规则，默认关闭。
CHATAPI_STORAGE_CLEANUP_ENABLED=0
# 清理执行时间，服务器本地时区，格式 HH:MM。
CHATAPI_STORAGE_CLEANUP_TIME=03:00
# 每个用户至少保留最近多少个会话；推荐 100，0 表示不按数量保留。
CHATAPI_STORAGE_CLEANUP_KEEP_RECENT_CONVERSATIONS=100
# 至少保留最近多少天的数据；推荐 30，0 表示不按天数保留。
CHATAPI_STORAGE_CLEANUP_KEEP_RECENT_DAYS=30
# 清理后执行数据库 VACUUM。SQLite 可回收文件空间，但会增加 I/O 并可能短暂锁库。
# 仅在启用自动清理且维护窗口允许阻塞时考虑开启，推荐 0。
CHATAPI_STORAGE_VACUUM_ENABLED=0

# ==============================================================================
# Pending 请求、运行时内存与实时连接
# ==============================================================================

# 等待人工响应的最长时间，0s 表示永不过期。公网实例可考虑 30m-24h。
CHATAPI_PENDING_TURN_TTL=0s
# Go GC 百分比；0 表示使用 Go 默认值。除非明确了解内存行为，否则保持 0。
CHATAPI_RUNTIME_GOGC=0
# Go 软内存限制，单位 bytes；0 表示不设置。容器部署可设为容器限制的约 80%。
CHATAPI_RUNTIME_MEMORY_LIMIT_BYTES=0
# 当前实例所有 realtime（WS/SSE/API lease）连接上限，0 表示不限。
CHATAPI_REALTIME_MAX_CONNECTIONS=0
# 单用户在当前实例的 realtime 连接上限，0 表示不限。
CHATAPI_REALTIME_MAX_CONNECTIONS_PER_USER=0
# 为每个用户的 Web 工作台预留连接数。推荐 1；不得挤占全部单用户额度。
CHATAPI_REALTIME_WEBUI_RESERVED_PER_USER=1

# ==============================================================================
# Lab 模式（仅 go run ./cmd/server lab 或对应 lab 启动方式使用）
# ==============================================================================

# 允许 Lab 绑定非回环地址。远程 Lab 必须同时配置 Token 或密码，生产不建议开启。
CHATAPI_ALLOW_REMOTE_LAB=0
# 启动后自动打开浏览器；本地 Lab 推荐 1，服务器推荐 0。
CHATAPI_OPEN_BROWSER=0
# 远程 Lab 访问凭据，至少配置一个。Token 适合程序，密码适合人工访问。
CHATAPI_LAB_TOKEN=
CHATAPI_LAB_PASSWORD=

# ==============================================================================
# GeeTest 人机验证（可选）
# ==============================================================================

# CAPTCHA_ID 与 CAPTCHA_KEY 必须同时填写；都留空表示禁用。
CHATAPI_GEETEST_CAPTCHA_ID=
CHATAPI_GEETEST_CAPTCHA_KEY=
CHATAPI_GEETEST_API_SERVER=https://gcaptcha4.geetest.com

# ==============================================================================
# SMTP 邮件（可选，用于验证码和密码重置）
# ==============================================================================

CHATAPI_SMTP_ENABLED=0
# 启用后 host 和 from 必填。常见端口：STARTTLS=587，TLS=465。
CHATAPI_SMTP_HOST=smtp.example.com
CHATAPI_SMTP_PORT=587
CHATAPI_SMTP_USERNAME=
CHATAPI_SMTP_PASSWORD=
CHATAPI_SMTP_FROM=ChatAPI <noreply@example.com>
# 可选 none、starttls、tls；公网邮件服务推荐 starttls 或 tls。
CHATAPI_SMTP_SECURITY=starttls
CHATAPI_SMTP_TIMEOUT=10s

# ==============================================================================
# 标准 OIDC 私密客户端（可选）
# ==============================================================================

CHATAPI_OIDC_ENABLED=0
CHATAPI_OIDC_PROVIDER_NAME=Example SSO
# 启用时 issuer、client id、client secret、redirect URL 必填；生产必须 HTTPS。
CHATAPI_OIDC_ISSUER_URL=https://idp.example.com
CHATAPI_OIDC_CLIENT_ID=chatapi
CHATAPI_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
CHATAPI_OIDC_REDIRECT_URL=https://chat.example.com/api/auth/oidc/callback
# 必须包含 openid，逗号分隔。
CHATAPI_OIDC_SCOPES=openid,email,profile
# 可选准入白名单，逗号分隔；全部留空表示不额外限制。
CHATAPI_OIDC_ALLOWED_DOMAINS=
CHATAPI_OIDC_ALLOWED_EMAILS=
# 匹配的邮箱自动获得管理员角色，务必谨慎配置。
CHATAPI_OIDC_ADMIN_EMAILS=
# 允许首次 OIDC 登录自动创建本地用户。
CHATAPI_OIDC_AUTO_CREATE_USER=0
# 唯一超级管理员邮箱。该已验证邮箱通过 OIDC 登录后获得 superadmin；只有它能授予管理员角色。
CHATAPI_SUPERADMIN_EMAIL=

# ==============================================================================
# Kirari 身份与模型端点集成（可选，普通部署无需配置）
# ==============================================================================

CHATAPI_KIRARI_ENABLED=0
CHATAPI_KIRARI_ISSUER_URL=https://kirari.example.com
CHATAPI_KIRARI_CLIENT_ID=chatapi
CHATAPI_KIRARI_CLIENT_SECRET=replace-with-kirari-client-secret
CHATAPI_KIRARI_REDIRECT_URL=https://chat.example.com/api/auth/kirari/callback
CHATAPI_KIRARI_SCOPES=openid,profile,email,offline_access,llm:read,llm:stream
# 可接受的 token issuer，逗号分隔。
CHATAPI_KIRARI_ALLOWED_ISSUERS=
# Kirari 元数据和 Chat Completions 端点；按服务提供方文档填写。
CHATAPI_KIRARI_META_ENDPOINT_URL=
CHATAPI_KIRARI_CHAT_COMPLETIONS_ENDPOINT_URL=

# ==============================================================================
# 测试专用（不要写入生产 .env）
# ==============================================================================

# PostgreSQL 集成测试 DSN，仅 backend/internal/testutil/pgtest 使用。
# CHATAPI_PG_TEST_DSN=postgres://postgres:postgres@127.0.0.1:5432/chatapi_test?sslmode=disable
